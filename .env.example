# Copy to .env.local and fill in. Never commit .env.local (git-ignored).
# Field names here must match packages/shared/src/env.ts's zod schema exactly (D-006/D-018:
# earlier revisions of this file used stale Base/CDP-era names that don't parse against it).

DATABASE_URL=postgres://thesauros:thesauros@localhost:5433/thesauros

ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# API key + Entity Secret from the Circle Developer Console (docs/VERIFY.md row 5). Required to
# provision a treasury wallet or run the worker/demo scripts; the web UI's read-only routes work
# without them.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# OpenServ (D-008: reasoning provider, independent of the Arc/Circle settlement chain). Required
# for mandate compilation and the autonomous loop's proposer/verifier; everything else (auth,
# policy activation, freeze/revoke/sweep, the demo attack script) works without it.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# 32+ bytes each. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
RECEIPT_HMAC_SECRET=

DEMO_MODE=true
THESAUROS_ALLOW_MAINNET=false
