{
  "name": "thesauros",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm db:migrate && turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run && pnpm test:policy",
    "test:adversarial": "tsx packages/reasoning/adversarial/run.ts",
    "test:e2e": "node scripts/not-yet.mjs test:e2e 7",
    "check:arch": "depcruise apps packages --config .dependency-cruiser.cjs && node scripts/check-arch-fixture.mjs && node scripts/check-lint-fixture.mjs",
    "check:arch:fixture": "node scripts/check-arch-fixture.mjs",
    "db:migrate": "pnpm --filter @thesauros/db migrate",
    "db:generate": "pnpm --filter @thesauros/db generate",
    "db:seed:demo": "tsx scripts/demo/seed.ts",
    "demo:provision-owner": "tsx scripts/demo/provision-owner.ts",
    "demo:fund-owner": "tsx scripts/demo/fund-owner.ts",
    "demo:attack": "tsx scripts/demo/attack.ts",
    "demo:drawdown": "tsx scripts/demo/drawdown.ts",
    "demo:reset": "tsx scripts/demo/reset.ts",
    "contracts:test": "forge test --root contracts",
    "contracts:build": "forge build --root contracts",
    "contracts:deploy": "tsx scripts/live/deploy-contracts.ts",
    "live:spend-permission": "tsx scripts/live/spend-permission-e2e.ts",
    "check:lint:fixture": "node scripts/check-lint-fixture.mjs",
    "test:policy": "vitest run --config packages/policy/vitest.config.ts --coverage",
    "test:record": "tsx scripts/live/record-serv-fixtures.ts",
    "live:executor": "tsx scripts/live/executor-e2e.ts",
    "live:loop": "tsx scripts/live/loop-e2e.ts",
    "live:env": "tsx scripts/live/env-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@thesauros/context": "workspace:*",
    "@thesauros/db": "workspace:*",
    "@thesauros/policy": "workspace:*",
    "@thesauros/reasoning": "workspace:*",
    "@thesauros/risk": "workspace:*",
    "@thesauros/shared": "workspace:*",
    "@thesauros/wallet": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.1",
    "jsdom": "^30.1.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.8",
    "vitest": "^5.0.1"
  }
}
